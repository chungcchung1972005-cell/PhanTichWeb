# Copy file này thành .env rồi điền API key thật (không commit .env lên git).
# Lấy key miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tuỳ chọn, mặc định gemini-3.5-flash-lite nếu để trống.
GEMINI_MODEL=
# Tuỳ chọn: model dự phòng, cách nhau bằng dấu phẩy, server thử lần lượt khi
# model chính quá tải/lỗi. Để trống = gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.6-flash
# (3.6-flash để cuối vì free tier chỉ ~20 lượt/ngày).
GEMINI_FALLBACK_MODELS=
# Tuỳ chọn, mặc định 3001 nếu để trống (hosting công khai thường tự set biến
# này, không cần điền tay khi deploy).
PORT=
# Domain thật của website sau khi public, cách nhau bằng dấu phẩy nếu nhiều
# domain (vd "https://ten-ban.github.io"). Để trống = mở cho mọi nơi gọi vào,
# CHỈ chấp nhận được khi chạy local. Xem server/DEPLOY.md.
ALLOWED_ORIGINS=
# API key tự đặt khi tạo webhook trên SePay (my.sepay.vn > Tích hợp WebHooks,
# kiểu chứng thực "API Key"). Dùng để server chỉ tin báo tiền về thật từ SePay.
# Để trống = webhook bị từ chối, thanh toán phí ảnh chọn thêm không tự xác nhận.
SEPAY_WEBHOOK_KEY=
# ---- Chat thật Khách <-> Sale (sale-chat.js, thêm 2026-09-27) ----
# Chuỗi kết nối MongoDB Atlas (Atlas > Connect > Drivers), dạng
# mongodb+srv://<user>:<mat-khau>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Để trống = lưu tin nhắn trong bộ nhớ, server khởi động lại là MẤT HẾT (chỉ để chạy thử local).
MONGODB_URI=
# Tên database trong cluster, để trống = aloha_baby.
MONGODB_DB=
# Chuỗi bí mật dài, ngẫu nhiên để ký mã đăng nhập (vd chạy: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# BẮT BUỘC đặt trên Render. Để trống = mỗi lần server khởi động lại mọi người phải đăng nhập lại.
AUTH_SECRET=
# ---- Đăng nhập bằng Google (sale-chat.js, thêm 2026-09-27) ----
# OAuth Client ID loại "Web application" tạo ở Google Cloud Console (từng bước: DEPLOY.md
# mục "Đăng nhập bằng Google"), dạng 1234-abc.apps.googleusercontent.com. KHÔNG cần client secret.
# Để trống = trang đăng nhập không hiện nút Google.
GOOGLE_CLIENT_ID=
# ---- Đồng bộ yêu cầu chỉnh ảnh Khách / Thợ ảnh / Sếp (edit-requests.js, thêm 2026-10-15) ----
# Chuỗi kết nối MongoDB RIÊNG cho yêu cầu chỉnh ảnh (user Atlas riêng, chỉ quyền readWrite trên
# database bên dưới). KHÔNG dùng lại MONGODB_URI của chat. Để trống = lưu RAM (mất khi server ngủ/khởi động lại).
EDIT_REQUESTS_MONGODB_URI=
# Tuỳ chọn, để trống = aloha_edit_demo. KHÔNG được trùng MONGODB_DB (trùng -> server từ chối, dùng RAM).
EDIT_REQUESTS_DB=
# Tuỳ chọn, để trống = edit_requests. KHÔNG được là chats / users.
EDIT_REQUESTS_COLLECTION=
# Tài khoản THỬ NGHIỆM (chỉ dùng được API chỉnh ảnh, KHÔNG vào được chat Sale), mảng JSON 1 dòng:
# [{"phone":"09000000101","role":"tho-anh","name":"Thợ thử nghiệm","salt":"<32 hex>","hash":"<128 hex>"}]
# role: tho-anh | sep | khach-hang. Tạo salt/hash: server/DEPLOY.md mục "Demo đồng bộ chỉnh ảnh".
# Coi như bí mật: KHÔNG commit, KHÔNG dán vào chat. Để trống = không có tài khoản thử nghiệm.
EDIT_DEMO_ACCOUNTS=
# CHỈ đặt =1 khi chạy test / phát triển local: cho Thợ ảnh/Sếp demo CÔNG KHAI (0900000003/0900000004)
# dùng API chỉnh ảnh. KHÔNG đặt trên Render (mặc định server chặn họ).
EDIT_REQUESTS_ALLOW_PUBLIC_DEMO_STAFF=
